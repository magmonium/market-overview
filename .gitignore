# Generated media — never committed. A day's video is a build artefact, and
# `store/` already carries everything needed to rebuild it.
output/*
!output/.gitkeep

# Operator-supplied licensed assets stay local. See resource/README.md —
# the licence is the operator's, and committing a music bed publishes it.
resource/*
!resource/README.md

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Node / Remotion (the render layer)
node_modules/
.remotion/
remotion-out/

# Remotion's `public/` folder — preview scaffolding only. The shipping pipeline deliberately **inlines** its
# assets (`logo.load` builds a data URI; the bed is muxed by ffmpeg) rather than serving them from here, so
# everything in this folder exists for `./bn` and nothing here belongs in a commit.
public/*

# macOS
.DS_Store
